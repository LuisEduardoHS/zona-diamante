{
  "name": "frontend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "predev": "npm run build:game && npm run build:icons",
    "dev": "npx @tailwindcss/cli -i ./src/css/input.css -o ./public/css/output.css --watch",
    "build": "npm run build:game && npm run build:icons && npm run build:css && npm run build:supabase && npm run build:config && npm run check:styles",
    "build:icons": "node ./scripts/generate-icons.cjs",
    "build:game": "node ./scripts/generate-game-config.cjs",
    "build:css": "npx @tailwindcss/cli -i ./src/css/input.css -o ./public/css/output.css --minify",
    "build:supabase": "esbuild ./scripts/supabase-entry.mjs --bundle --format=esm --platform=browser --minify --outfile=./public/vendor/supabase.js",
    "build:config": "node ./scripts/generate-runtime-config.cjs",
    "check:styles": "node ./scripts/check-styles.cjs",
    "test": "node scripts/test.cjs",
    "preview:game": "npm run build:game && node checks/phase04-preview.cjs",
    "preview:site": "npm run build:game && npm run build:css && node checks/site-review-server.cjs",
    "preview:foto": "node tests/preview-foto-ar.cjs",
    "preview:navegacion": "node tests/preview-foto-ar.cjs --simular-ar"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "esbuild": "^0.28.2",
    "lucide-static": "1.70.0",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
